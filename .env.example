# ==========================================
# Legal Chatbot RAG - Environment Variables
# ==========================================

# ------------------------------------------
# 1. LLM Provider Switch
# Pilihan: 'ollama' (Lokal, Tanpa Kuota API) atau 'groq' (Cloud API)
# ------------------------------------------
LLM_PROVIDER=ollama

# ------------------------------------------
# 2. Local Mode Config (Ollama)
# Gunakan 'http://host.docker.internal:11434' jika backend jalan di Docker Compose
# Gunakan 'http://localhost:11434' jika backend dijalankan langsung via python lokal
# ------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# Timeout inferensi lokal dalam detik (disarankan 300.0 jika inferensi berbasis CPU)
OLLAMA_TIMEOUT=300.0

# ------------------------------------------
# 3. Cloud Mode Config (Groq) - Wajib jika LLM_PROVIDER=groq
# Dapatkan API Key di https://console.groq.com/keys
# ------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------
# 4. Security & Authentication
# Kunci rahasia untuk autentikasi header X-API-Key antar frontend dan backend
# ------------------------------------------
APP_API_KEY=your_secure_api_key_here

# ------------------------------------------
# 5. ChromaDB Server Connection
# ------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ------------------------------------------
# 6. Embedding & Reranker Models
# ------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=false
