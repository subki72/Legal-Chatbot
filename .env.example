# ==========================================
# Legal Chatbot RAG - Environment Variables
# ==========================================

# Groq Cloud API Key (Required)
GROQ_API_KEY=your_groq_api_key_here

# Application API Key for X-API-Key Header Auth (Generate a secure random string)
APP_API_KEY=your_secure_api_key_here

# ChromaDB Server Connection
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Model Selection
LLM_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
