# ============================================================
# Legal Chatbot RAG - Environment Configuration Template
# Copy this file to .env and fill in your values:
#   Windows: Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
# ============================================================

# ----------------------------------------------------------------
# 1. LLM Provider Selection
# Options: 'ollama' (local, no API cost) or 'groq' (cloud API)
# ----------------------------------------------------------------
LLM_PROVIDER=ollama

# ----------------------------------------------------------------
# 2. Local Serving Mode (Ollama)
# Use 'http://host.docker.internal:11434' when backend runs in Docker Compose.
# Use 'http://localhost:11434' when backend runs directly on the host.
# ----------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# Inference timeout in seconds (300s recommended for CPU-bound local models)
OLLAMA_TIMEOUT=300.0

# ----------------------------------------------------------------
# 3. Cloud Serving Mode (Groq) - Required when LLM_PROVIDER=groq
# Obtain an API key at: https://console.groq.com/keys
# ----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------
# 4. Security & Authentication
# Shared secret key for X-API-Key header authentication between
# the frontend client and the backend REST API.
# ----------------------------------------------------------------
APP_API_KEY=your_secure_api_key_here

# ----------------------------------------------------------------
# 5. ChromaDB Vector Database Connection
# ----------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ----------------------------------------------------------------
# 6. Embedding & Reranker Model Identifiers
# ----------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=false
